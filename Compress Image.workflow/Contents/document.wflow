				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/zsh

# Finder-invoked Services start with a sanitized PATH that omits Homebrew's
# bin dirs, so `command -v magick` would otherwise fail on every run and
# retrigger the Homebrew installer (which asks for sudo 3x).
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

if ! command -v magick &amp;&gt;/dev/null; then
    if ! command -v brew &amp;&gt;/dev/null; then
        osascript -e 'display notification "Installing Homebrew. macOS will ask for your password to create /opt/homebrew." with title "Compress Image" subtitle "First-time setup"'
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

        if [[ -d "/opt/homebrew/bin" ]]; then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        elif [[ -d "/usr/local/bin" ]]; then
            eval "$(/usr/local/bin/brew shellenv)"
        fi
    fi

    osascript -e 'display notification "Installing ImageMagick via Homebrew." with title "Compress Image" subtitle "First-time setup"'
    brew install imagemagick
fi

# Compress images
processed=0
for f in "$@"
do
    ext="${f##*.}"
    base="${f%.*}"
    out="${base}_compressed.${ext}"

    case "${ext:l}" in
        jpg|jpeg)
            if magick "$f" -strip -auto-orient -interlace Plane -quality 75 "$out"; then
                processed=$((processed + 1))
                echo "Compressed: $out"
            fi
            ;;
        png)
            if magick "$f" -strip -auto-orient -define png:compression-level=9 -define png:exclude-chunk=all "$out"; then
                processed=$((processed + 1))
                echo "Compressed: $out"
            fi
            ;;
        *)
            echo "Unsupported format: $f"
            ;;
    esac
done

if [ "$processed" -eq 0 ]; then
    msg="No images were compressed"
elif [ "$processed" -eq 1 ]; then
    msg="Compressed 1 image"
else
    msg="Compressed $processed images"
fi
MSG="$msg" osascript -e 'display notification (system attribute "MSG") with title "Compress Image"'</string>
