				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/zsh

# Ensure Homebrew is installed
if ! command -v brew &amp;&gt;/dev/null; then
    echo "Homebrew not found. Installing..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    if [[ -d "/opt/homebrew/bin" ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"   # Apple Silicon
    elif [[ -d "/usr/local/bin" ]]; then
        eval "$(/usr/local/bin/brew shellenv)"      # Intel
    fi
fi

# Ensure ImageMagick is installed
if ! command -v magick &amp;&gt;/dev/null; then
    echo "ImageMagick not found. Installing..."
    brew install imagemagick
fi

# Trim transparent borders without cropping opaque images that merely share a flat edge color
for f in "$@"
do
    base="${f%.*}"
    out="${base}_trimmed.png"

    if [[ "$(magick identify -format '%[opaque]' "$f" 2&gt;/dev/null)" == "True" ]]; then
        echo "Skipped (no transparent pixels found): $f"
        continue
    fi

    has_transparent_corner=false
    for gravity in NorthWest NorthEast SouthWest SouthEast
    do
        if [[ "$(magick "$f" -auto-orient -gravity "$gravity" -crop 1x1+0+0 -format '%[opaque]' info: 2&gt;/dev/null)" == "False" ]]; then
            has_transparent_corner=true
            break
        fi
    done

    if [[ "$has_transparent_corner" != true ]]; then
        echo "Skipped (transparent pixels are not on the outer border): $f"
        continue
    fi

    original_geometry="$(magick "$f" -auto-orient -format '%wx%h+0+0' info: 2&gt;/dev/null)"
    trim_geometry="$(magick "$f" -auto-orient -alpha extract -trim -format '%wx%h%O' info: 2&gt;/dev/null)"

    if [[ -z "$trim_geometry" || "$trim_geometry" == *-1-1 ]]; then
        echo "Skipped (could not detect non-transparent bounds): $f"
        continue
    fi

    if [[ "$trim_geometry" == "$original_geometry" ]]; then
        echo "Skipped (no transparent border to trim): $f"
        continue
    fi

    magick "$f" -auto-orient -crop "$trim_geometry" +repage PNG32:"$out"
    echo "Trimmed: $out"
done</string>
