				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/zsh

# Finder-invoked Services start with a sanitized PATH that omits Homebrew's
# bin dirs, so `command -v ffmpeg` would otherwise fail on every run and
# retrigger the Homebrew installer (which asks for sudo 3x).
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

if ! command -v ffmpeg &amp;&gt;/dev/null; then
    if ! command -v brew &amp;&gt;/dev/null; then
        osascript -e 'display notification "Installing Homebrew. macOS will ask for your password to create /opt/homebrew." with title "Compress Video" subtitle "First-time setup"'
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

        if [[ -d "/opt/homebrew/bin" ]]; then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        elif [[ -d "/usr/local/bin" ]]; then
            eval "$(/usr/local/bin/brew shellenv)"
        fi
    fi

    osascript -e 'display notification "Installing ffmpeg via Homebrew." with title "Compress Video" subtitle "First-time setup"'
    brew install ffmpeg
fi

# Compress videos with H.264 + AAC into MP4 (CRF 28 ≈ visually transparent at
# small sizes; raise for smaller files, lower for higher quality).
processed=0
for f in "$@"
do
    base="${f%.*}"
    out="${base}_compressed.mp4"

    if ffmpeg -y -hide_banner -loglevel error -i "$f" \
        -c:v libx264 -crf 28 -preset medium -pix_fmt yuv420p \
        -c:a aac -b:a 128k \
        -movflags +faststart \
        "$out"; then
        processed=$((processed + 1))
        echo "Compressed: $out"
    fi
done

if [ "$processed" -eq 0 ]; then
    msg="No videos were compressed"
elif [ "$processed" -eq 1 ]; then
    msg="Compressed 1 video"
else
    msg="Compressed $processed videos"
fi
MSG="$msg" osascript -e 'display notification (system attribute "MSG") with title "Compress Video"'</string>
